REGISTRAR_DB_URL=jdbc:mariadb://127.0.0.1:3306/eacdb?createDatabaseIfNotExist=true
REGISTRAR_DB_USERNAME=registrar_user
REGISTRAR_DB_PASSWORD=change-me

REGISTRAR_TEMP_PASSWORD=change-me-temporary-password
REGISTRAR_STUDENT_INITIAL_PASSWORD=change-me-student-temporary-password

ADMISSION_BASE_URL=http://localhost:8081
ENROLLMENT_BASE_URL=http://localhost:8082
APP_UPLOAD_DIR=C:/path/to/admission/uploads
REGISTRAR_SHARED_UPLOAD_DIR=C:/path/to/enrollment_uploads

REGISTRAR_SHOW_SQL=false
REGISTRAR_ERROR_INCLUDE_MESSAGE=never
REGISTRAR_ERROR_INCLUDE_BINDING_ERRORS=never

REGISTRAR_BOOTSTRAP_REFERENCE_DATA_ENABLED=false
REGISTRAR_BOOTSTRAP_DEMO_DATA_ENABLED=false
REGISTRAR_BOOTSTRAP_DEFAULT_USERS_ENABLED=false
REGISTRAR_BOOTSTRAP_LEGACY_MIGRATION_ENABLED=false

# MCP remains enabled by current owner decision.
REGISTRAR_MCP_ENABLED=true
